<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="Lab3PU" transaction-type="RESOURCE_LOCAL">
        <!-- Сущности -->
        <class>org.acrighthere.lab3.Model.HitResult</class>
        <class>org.acrighthere.lab3.Model.Point</class>

        <!-- Настройка провайдера JPA (Hibernate например) -->
        <properties>
            <!-- JDBC настройки -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="${db.url}"/>
            <property name="jakarta.persistence.jdbc.user" value="${db.user}"/>
            <property name="jakarta.persistence.jdbc.password" value="${env.pass}"/>

            <!-- Hibernate свойства -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/> <!-- create / update / validate -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>